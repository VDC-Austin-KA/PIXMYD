<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>CFBundleDisplayName</key>
  <string>PIXMYD</string>
  <key>UILaunchScreen</key>
  <dict/>
  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>arkit</string>
  </array>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <key>NSCameraUsageDescription</key>
  <string>PIXMYD uses the camera to photograph the site you are scanning. Images stay on this device unless you export them.</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>PIXMYD records a position for each capture so the result can be placed in project coordinates. Without it a scan has no georeference.</string>
  <key>NSMotionUsageDescription</key>
  <string>PIXMYD reads the motion sensors to track where the camera is between frames. Scanning does not work without them.</string>
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>PIXMYD connects to an external RTK GNSS receiver over Bluetooth for centimetre-accurate positions.</string>
  <key>NSPhotoLibraryAddUsageDescription</key>
  <string>PIXMYD saves exported models and point clouds to your photo library when you ask it to.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>PIXMYD reaches an NTRIP caster for RTK corrections, and transfers point sets and scans to and from PIXMYD-Nav on a workstation you scan a code from. Both are connections you start.</string>

  <!--
    App Transport Security blocks plain HTTP from the URL loading system, and
    the transfer session is plain HTTP to a private address on the site wifi.

    NSAllowsLocalNetworking is the narrow exception for exactly that: it permits
    insecure loads to local-network hosts and leaves ATS enforced for everything
    else. NSAllowsArbitraryLoads would also work and would be wrong: it turns
    the protection off for the whole app to fix one link-local case.

    A certificate is not the alternative. The host is a Navisworks plugin on a
    DHCP address with no name and no CA, so it could only offer a self-signed
    one, and training people to tap through a TLS warning buys nothing against
    an attacker already on the wifi. The session token is the control.

    RTK never needed this: NtripClient is a raw NWConnection, and ATS only
    applies to URLSession.
  -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>

  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
  <key>UIBackgroundModes</key>
  <array>
    <string>location</string>
    <string>external-accessory</string>
  </array>
  <key>UISupportedExternalAccessoryProtocols</key>
  <array>
    <string>com.emlid.reach</string>
    <string>com.bad-elf.gps</string>
    <string>com.trimble.correction</string>
  </array>
</dict>
</plist>
